{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/order",
      "destination": "/public/order.html"
    },
    {
      "source": "/kitchen",
      "destination": "/public/kitchen.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
