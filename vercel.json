{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/order",
      "destination": "/order.html"
    },
    {
      "source": "/order/",
      "destination": "/order.html"
    },
    {
      "source": "/kitchen",
      "destination": "/kitchen.html"
    },
    {
      "source": "/kitchen/",
      "destination": "/kitchen.html"
    }
  ]
}
