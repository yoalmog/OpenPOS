{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpos-cloudflare-staging",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "36d9fda64d0149a19b5a36a2595688e4"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api",
      "/api/*",
      "/health",
      "/health/*",
      "/order",
      "/order/",
      "/kitchen",
      "/kitchen/"
    ],
    "html_handling": "none"
  },
  "vars": {
    "SERVICE_NAME": "openpos-cloudflare-staging"
  }
}
