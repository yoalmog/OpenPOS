{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpos-cloudflare-staging",
  // Isolated staging configuration; Production uses a separate deployment.
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "36d9fda64d0149a19b5a36a2595688e4"
    }
  ]
}
