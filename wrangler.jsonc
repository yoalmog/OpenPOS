{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpos-cloudflare-staging",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "36d9fda64d0149a19b5a36a2595688e4"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "SERVICE_NAME": "openpos-cloudflare-staging",
    "FIREBASE_PROJECT_ID": "openpos-web",
    "FIREBASE_API_KEY": "AIzaSyA85la4pz4q23rQMq_bHdQ7rjxqrmXCc8o",
    "OPENPOS_OWNER_EMAIL": "yoalmog@gmail.com"
  }
}
